# /etc/systemd/system/paillasse-backup.service
[Unit]
Description=Sauvegarde de Paillasse (base + pièces jointes)
After=postgresql.service

[Service]
Type=oneshot
User=paillasse
Environment=APP_DIR=/opt/paillasse
Environment=BACKUP_DEST=/mnt/sauvegardes/paillasse
ExecStart=/opt/paillasse/deploy/backup.sh
