# Copier en server/.env puis adapter
PORT=3070
HOST=0.0.0.0
DATABASE_URL=postgres://paillasse:CHANGER_MOI@localhost:5432/paillasse

# Dossier des pièces jointes (relatif à server/ ou absolu). À inclure dans les sauvegardes !
DATA_DIR=../data

# Secret de signature des sessions : générer avec  openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=30
# true si l'application est servie en HTTPS (derrière nginx par exemple)
SECURE_COOKIES=false
MAX_UPLOAD_MB=500

# Premier compte (administrateur : il arrive sur la page Maintenance), créé au premier démarrage
# si la base est vide. Retirer ADMIN_PASSWORD une fois le compte créé
# (ou utiliser : npm run create-user -- louis "Louis" --admin)
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=

# Assistant IA du labo (facultatif) : une IA (Open WebUI ou compatible) appelle Paillasse au nom de la
# personne qui lui parle, avec les droits de son compte. Voir README › Intégrations › Assistant du labo.
# Nom affiché, et adresse de l'assistant (lien « Ouvrir l'assistant » dans Paillasse)
ASSISTANT_NAME=
ASSISTANT_URL=
# Identité de la personne, au choix (ou les deux) :
#  1. en-tête signé (Open WebUI : ENABLE_FORWARD_USER_INFO_HEADERS=true et FORWARD_USER_INFO_HEADER_JWT_SECRET,
#     même valeur ici ; en-tête X-OpenWebUI-User-Jwt par défaut)
ASSISTANT_JWT_SECRET=
ASSISTANT_JWT_HEADER=
#  2. session transmise par l'assistant (serveur d'outils déclaré en authentification « Session »), vérifiée
#     auprès de l'assistant (Open WebUI : http://<adresse>/api/v1/auths/)
ASSISTANT_IDENTITY_URL=
# Identifiant du message en cours, joint par Open WebUI quand ses en-têtes sont transmis (X-OpenWebUI-Message-Id par
# défaut) : une écriture n'est alors confirmée que dans un message suivant, après la réponse de la personne
ASSISTANT_TURN_HEADER=
# Facultatif : outils proposés (liste de noms, sinon la sélection par défaut), préfixe de leurs noms
# (paillasse_ par défaut, « aucun » pour s'en passer), taille maximale d'une réponse en caractères (6000 par défaut)
ASSISTANT_TOOLS=
ASSISTANT_TOOL_PREFIX=
ASSISTANT_MAX_CHARS=
