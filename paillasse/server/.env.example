# Copier en server/.env puis adapter
PORT=3070
HOST=0.0.0.0
DATABASE_URL=postgres://paillasse:CHANGER_MOI@localhost:5432/paillasse

# Dossier des pièces jointes (relatif à server/ ou absolu). À inclure dans les sauvegardes !
DATA_DIR=../data

# Secret de signature des sessions : générer avec  openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=30
# true si l'application est servie en HTTPS (derrière nginx par exemple)
SECURE_COOKIES=false
MAX_UPLOAD_MB=500

# Premier compte (administrateur : il arrive sur la page Maintenance), créé au premier démarrage
# si la base est vide. Retirer ADMIN_PASSWORD une fois le compte créé
# (ou utiliser : npm run create-user -- louis "Louis" --admin)
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=
